# Chronos .env example: every setting you can set, generated by `chronos docs` from the code (do not edit by hand).
# Easiest: chronos setup (asks, tests and saves each one). Secrets: chronos set KEY (typed hidden, tested, never echoed).
# Docs: docs/CONFIGURATION.md

# ── Connection
# Arbitrum One RPC url the console scans with (contains your provider key) (secret)
# ARB_RPC_URL=
# generic RPC url some of your scripts read (secret)
# RPC_URL=
# backup Arbitrum RPC url (secret)
# ARBITRUM_RPC_URL=
# Alchemy Arbitrum url (secret)
# ALCHEMY_RPC_URL=
# private / protected RPC url (secret)
# ARB_PRIVATE_RPC=
# Alchemy API key (tested against its Arbitrum endpoint) (secret)
# ALCHEMY_API_KEY=
# websocket url: the engine reacts to every new block (secret)
# ARBITRUM_WSS_URL=
# second websocket url (another provider) for a redundant block feed (secret)
# ARB_WSS_URL=
# Alchemy websocket url for a redundant block feed (secret)
# ALCHEMY_WSS_URL=
# another websocket url for a redundant block feed (secret)
# ARBITRUM_WSS_URL_2=
# price-move relay through your Supabase: share the pools your node sees move and re-quote the ones other engines saw move (default on; off to stop)
# CHRONOS_RELAY=
# Morpho Blue address that research reads for fee-free flash loans (default: Arbitrum One's 0x6c247b1F…8F5e; off to skip)
# CHRONOS_MORPHO=
# Uniswap V4 PoolManager the engine borrows from with no fee when your contract is v2.3+ (default: Arbitrum One's 0x360E68fa…FB32; off to skip)
# CHRONOS_UNI_V4=
# how far the engine may speed up when scans find real gaps: 0 (never) to 3 (scans 3× as often, 2.5× routes quoted; default 3), always inside each node's plan
# CHRONOS_TEMPO_MAX=
# a second Arbitrum node from ANOTHER provider: verifies balances at the same block and broadcasts your trades twice (secret)
# ARB_RPC_URL_2=
# another Arbitrum node (any provider): scans in turn with the others, inside its plan (secret)
# ARB_RPC_URL_4=
# another Arbitrum node (any provider): scans in turn with the others, inside its plan (secret)
# ARB_RPC_URL_5=
# Infura API key alone (its Arbitrum url and websocket are built from it) (secret)
# INFURA_API_KEY=
# SwiftNodes API key alone (its Arbitrum url and websocket are built from it) (secret)
# SWIFTNODES_API_KEY=
# your Infura plan: free, developer, team or custom (Chronos keeps inside its credits)
# INFURA_PLAN=
# your SwiftNodes plan: free, starter, growth, scale, pro or custom
# SWIFTNODES_PLAN=
# your dRPC Arbitrum endpoint, copied from your dRPC dashboard (paced inside DRPC_PLAN) (secret)
# DRPC_ARB_URL=
# your dRPC plan: free (25 req/s, batches of 3), payg (100), pro (300) or scale (600)
# DRPC_PLAN=
# your Ankr Arbitrum endpoint (https://rpc.ankr.com/arbitrum/… from your Ankr dashboard) (secret)
# ANKR_ARB_URL=
# your Ankr plan: public, freemium (1M calls a month) or premium (websocket, 1.5k req/s)
# ANKR_PLAN=
# your Chainstack Arbitrum node url (https://….core.chainstack.com/…) (secret)
# CHAINSTACK_ARB_URL=
# your GetBlock API key: the access token of an Arbitrum One endpoint in your GetBlock dashboard (create the endpoint for Arbitrum mainnet; the key is the long string after the host). Tested against Arbitrum One at GETBLOCK_REGION (secret)
# GETBLOCK_API_KEY=
# where your GetBlock endpoint was created: us-east-1 (New York, default), eu-central-1 (Frankfurt) or ap-southeast-1 (Singapore)
# GETBLOCK_REGION=
# your GetBlock Arbitrum One endpoint (https://shared.<region>.getblock.io/<access token>/, from your GetBlock dashboard; paced inside GETBLOCK_PLAN) (secret)
# GETBLOCK_ARB_URL=
# your GetBlock plan: free (50,000 CU a day, 20 req/s: about 2,500 Arbitrum calls a day), starter (90M CU a month, 250 req/s), growth, advanced, scale, pro, premium or dedicated
# GETBLOCK_PLAN=
# your Chainstack plan: developer (25 req/s, logs 100 blocks), growth (250) or business (600)
# CHAINSTACK_PLAN=
# on: also use keyless public nodes (dRPC https://arbitrum.drpc.org) as paced failover
# CHRONOS_PUBLIC_NODES=
# node key that scans (unset: chosen by plan)
# CHRONOS_PRIMARY_NODE=
# a third Arbitrum node from yet another provider (e.g. SwiftNodes): another failover and balance check (secret)
# ARB_RPC_URL_3=
# burst (default): every scan read spread over all your nodes at once, a rate limit fails over at once; paced: one node per scan inside each plan's pace
# CHRONOS_SCAN_MODE=
# free (default): burst only nodes whose plan refuses past its limit (no bill); all: every node, even ones that may bill per request
# CHRONOS_BURST_NODES=
# burst mode: a node slower than this (ms) is skipped for the request and cools down (default 2500)
# CHRONOS_RPC_TIMEOUT_MS=
# burst mode: pause between scans in ms (default 0: the next scan starts when one ends)
# CHRONOS_BURST_GAP_MS=
# on (default): trades are also sent through Arbitrum's public endpoint, so they get out when your nodes are rate-limited; off to stop
# CHRONOS_SEQUENCER_BROADCAST=

# ── AI
# OpenRouter key for AI agents (the only setting the AI agent needs: the model is chosen for you) (secret)
# OPENROUTER_API_KEY=
# another OpenRouter key: used in turn with the others, each the fallback of the rest (secret)
# OPENROUTER_API_KEY_2=
# another OpenRouter key (fallback in the rotation) (secret)
# OPENROUTER_API_KEY_3=
# another OpenRouter key (fallback in the rotation) (secret)
# OPENROUTER_API_KEY_4=
# another OpenRouter key (fallback in the rotation) (secret)
# OPENROUTER_API_KEY_5=
# Anthropic API key: Claude directly, in the same rotation as your OpenRouter keys (secret)
# ANTHROPIC_API_KEY=
# Claude model for ANTHROPIC_API_KEY (default claude-sonnet-5-5)
# CHRONOS_ANTHROPIC_MODEL=
# what one AI call is counted as against the daily spending cap (default 0.02 dollars)
# CHRONOS_AI_CALL_USD=
# most AI analyses the VP may run a day (default 12; 0 turns the analyst off)
# CHRONOS_VP_AI_MAX_PER_DAY=
# minutes between two AI analyses (default 60)
# CHRONOS_VP_AI_MIN_GAP_MIN=
# most cells the honeycomb mind may hold (default 120; it grows by 15 per open task up to this)
# CHRONOS_MIND_MAX_CELLS=
# extra folders (comma-separated) the VP's documentation archive indexes, secrets skipped
# CHRONOS_ARCHIVE_FROM=
# OpenRouter model id for the AI agent (provider/model). Empty: the newest Claude Sonnet OpenRouter lists
# CHRONOS_AGENT_MODEL=

# ── Safety
# how owner actions (deploy, setup, payouts) are signed: metamask (you approve each one in MetaMask on a local page; the key never leaves MetaMask) or keystore (default: your encrypted keystore passphrase). One run: add --metamask
# CHRONOS_OWNER_SIGNER=
# most a day (UTC) may cost in things no profit pays back: reverted trades' gas, AI calls (default 5). Anything that could go over it waits until the next day; trades that fit keep running
# CHRONOS_DAILY_SPEND_CAP_USD=
# seconds the engine's loop may go without a sign of life before the watchdog restarts it (default 300, at least 60; off to turn it off)
# CHRONOS_WATCHDOG_STALL_SEC=

# ── Company
# hours between the VP's reminders about a road-to-cash step that is yours (default 3)
# CHRONOS_VP_NUDGE_HOURS=
# minutes between the VP's audits after its tasks (your checks + Blockscout + next step; default 30)
# CHRONOS_VP_AUDIT_MIN=
# quiet hours for those reminders, local time HH-HH (default 21-08; milestone results and money alerts still come)
# CHRONOS_VP_QUIET=
# days an indicator may run without firing once before it is retired (default 7; it comes back the first time it would fire)
# CHRONOS_INDICATOR_RETIRE_DAYS=
# local time the VP writes your daily report (HH:MM, 24 h; default 07:30)
# CHRONOS_REPORT_TIME=
# install newer releases by itself (on, the default; off: only notify). Only releases your publishing device signed, sha256-verified; your .env and data are kept; contract changes still need chronos deploy
# CHRONOS_AUTO_UPDATE=
# your time zone for the daily report (IANA name; default America/Los_Angeles)
# CHRONOS_TZ=

# ── Alerts
# where incidents, resolution attempts and escalations go as signed JSON. Empty: your portal (your project's alerts function, device-signed). Your own https url, or off (secret)
# CHRONOS_ALERT_WEBHOOK_URL=
# shared secret for the webhook signature (x-chronos-signature: HMAC-SHA256 over timestamp.body) (secret)
# CHRONOS_ALERT_WEBHOOK_SECRET=
# where phone-style alerts also go. Empty: your portal (money made or lost, errors). Your own https url (Discord/Slack style), or off (secret)
# CHRONOS_WEBHOOK_URL=
# webhook for Arbitrum events (secret)
# ARB_WEBHOOK_URL=
# your portal page (https://…): the buttons in the daily report email open it
# CHRONOS_PORTAL_URL=

# ── Data services
# Supabase project url
# SUPABASE_URL=
# Supabase service-role key (full database access: keep private) (secret)
# SUPABASE_SERVICE_KEY=
# api.data.gov key (GovInfo, federal data) (secret)
# DATA_GOV_API_KEY=
# RapidAPI key (secret)
# RAPIDAPI_KEY=
# CarsXE vehicle data key (secret)
# CARSXE_API_KEY=
# Veryfi client id (secret)
# VERYFI_CLIENT_ID=
# Veryfi username
# VERYFI_USERNAME=
# Veryfi API key (secret)
# VERYFI_API_KEY=
# IDScan key (secret)
# IDSCAN_API_KEY=
# IDScan bearer token (secret)
# IDSCAN_BEARER_TOKEN=
# HeritageDeed key (secret)
# HERITAGEDEED_API_KEY=
# your 1inch Business API key (business.1inch.com/portal; one key covers every 1inch API): routing, prices and liquidity sources on Arbitrum. Tested with a read-only call on Arbitrum One (secret)
# ONEINCH_API_KEY=
# your Etherscan API key (etherscan.io/myapikey; API V2 covers Arbitrum One with chainid=42161): competitor trades, contract and pool lookups, receipts. Tested with a read-only call on Arbitrum One (secret)
# ETHERSCAN_API_KEY=

# ── Google
# Drive folder id used by sync scripts
# GOOGLE_DRIVE_FOLDER_ID=
# path to your service-account JSON file (the path, not the contents)
# GOOGLE_APPLICATION_CREDENTIALS=

# ── Cloud
# Supabase ingest URL (portal data)
# CHRONOS_SYNC_URL=
# the Google Drive folder that holds your env files: the key pull on update reads only that folder (fast) instead of listing your whole Drive
# CHRONOS_DRIVE_ENV_FOLDER=

# ── Execution
# your deployed ChronosFlashArb contract
# CHRONOS_FLASH_ARB_ADDRESS=
# an older contract name other tools also use: Chronos uses it only after checking on-chain that it is a Chronos contract, then saves it as CHRONOS_FLASH_ARB_ADDRESS
# CONTRACT_ADDRESS=
# Cloud KMS HSM key version that signs trades (printed by cloud/gcp-setup.sh); the key itself never leaves Google
# CHRONOS_EXECUTOR_KMS_KEY=
# your executor (an operator on your contract): signs trades through the Cloud KMS key, or on this phone through the key agent (chronos executor import); without either, the shadow test runs from it
# CHRONOS_EXECUTOR_ADDRESS=
# the most worst-case gas (gas limit × max fee) the phone key agent signs for one trade (default 0.05 ETH; read at chronos executor unlock)
# CHRONOS_AGENT_MAX_TX_ETH=

# ── Voice
# the Android voice engine chronos narrate speaks with (chronos narrate --voices lists them; empty = your phone default)
# CHRONOS_VOICE_ENGINE=
# voice language for chronos narrate, e.g. en
# CHRONOS_VOICE_LANG=
# voice region for chronos narrate, e.g. US or GB
# CHRONOS_VOICE_REGION=
# a specific voice of your Android engine (the variant name your engine lists)
# CHRONOS_VOICE_VARIANT=
# Mac only: the voice name for chronos narrate (say -v ? lists them)
# CHRONOS_VOICE=
# speaking speed for chronos narrate (1.0 normal, 1.2 a bit faster)
# CHRONOS_VOICE_RATE=
# voice pitch for chronos narrate (1.0 normal)
# CHRONOS_VOICE_PITCH=
# seconds between routine scan reports in the commentary (anything notable is said at once)
# CHRONOS_NARRATE_SCAN_SEC=

# ── Wallet addresses (public)
# where profit is paid
# PAYOUT_WALLET_ADDRESS=
# Policy T1 tax reserve address
# TAX_RESERVE_VAULT=
# wallet that pays gas
# GAS_WALLET_ADDRESS=
# operating treasury address
# OPERATING_TREASURY=

# ── Scanner (suggested starting values; each is checked against its range)
# absolute minimum net profit per trade, USD (the floor is this or FLOOR_GAS_MULT × the route's gas, whichever is larger) · 0.01 – 10000
MIN_NET_PROFIT_USD=0.05
# a trade must keep at least this many times its own gas cost (default 2; 0 = fixed floor only) · 0 – 20
FLOOR_GAS_MULT=2
# max price impact per leg, basis points · 1 – 500
MAX_SLIPPAGE_BPS=35
# gas gate: no trade above this gas price · 0.001 – 10
GAS_CEILING_GWEI=0.05
# gas units for flash loan + 2 swaps (calibrate it) · 100000 – 5000000
GAS_UNITS_ASSUMED=900000
# borrow sizes to try; smallest and largest are your limits · 1 – 1000000
SIZE_LADDER_USD=200,500,1000,2500,5000,10000,25000
# size used to screen every route · 1 – 1000000
SCREEN_SIZE_USD=1000
# routes that get the full size search · 1 – 100
SCAN_TOPK=12
# refinement steps after the ladder · 0 – 64
OPT_REFINE_ITERS=16
# on-chain minProfit as share of quoted profit · 0 – 10000
MIN_PROFIT_CAPTURE_BPS=5000
# small probe used to measure price impact · 0.01 – 10000
SLIPPAGE_PROBE_USD=10
# deadline in prepared contract calls · 10 – 3600
DEADLINE_SECONDS=120
# longest route tried (2 to 5; never more than your deployed contract accepts: v2.1+ takes 5, older 4; 5 costs many more quotes per scan) · 2 – 5
SCAN_MAX_LEGS=4
# tokens beyond Aave's reserves to look for pools between (nominated by the public token list, checked on-chain; 0 = off) · 0 – 200
CHRONOS_DISCOVER_TOKENS=40
# fast re-check of the closest routes between full scans, in ms (0 = off) · 0 – 60000
HOT_SCAN_MS=3000
# depth check: a pool whose small probe trade gets less than this share of its own quoted price is benched (it has a price but almost nothing behind it) · 0.05 – 0.99
DEPTH_MIN_FILL=0.5
# depth floor: a V2 pair holding less than this many USD on a priced side is left out of routing (unset: the larger of $1,000 and 5× your smallest trade size) · 0 – 10000000
DEPTH_MIN_USD=1000
# a route losing more than this % of its size at screening is a dead pool (benched, never shortlisted), not a missing price gap · 1 – 50
DEAD_LOSS_PCT=5
# hours a pool that failed the depth check stays out of routing before it is tried again · 0.25 – 72
DEPTH_BENCH_HOURS=6
# minutes between competitor research runs on your primary device (flash loans and own-capital arbitrage from the chain, pooled in chain_trades) · 10 – 1440
RESEARCH_EVERY_MIN=60
# how many of the newest blocks research reads every swap from to find own-capital arbitrage (600 ≈ 2.5 min; 0 = flash loans only). Larger reads more logs from your node · 0 – 20000
RESEARCH_SWAP_BLOCKS=600
# cycles that pass the price screen and get real quotes each scan · 10 – 5000
SCAN_QUOTE_CYCLES=400

# ── Measurement (suggested starting values; each is checked against its range)
# length of a measurement run · 1 – 10080
MEASURE_MINUTES=60
# seconds between scans · 5 – 3600
MEASURE_INTERVAL_SEC=20
# GO needs at least this many opportunity episodes · 1 – 100000
GO_MIN_EPISODES=5
# GO needs opportunities in this many blocks · 1 – 100000
GO_MIN_DISTINCT_BLOCKS=5
# GO needs this projected $/day (upper bound) · 0 – 1000000000
GO_MIN_USD_PER_DAY=5

# ── Policies (suggested starting values; each is checked against its range)
# T1: share of verified gross profit reserved for tax (3000 = 30%) · 0 – 10000
POLICY_T1_TAX_BPS=3000
# a realized loss this large in a UTC day switches live trading back to shadow · 0 – 1000000000
MAX_DAILY_DRAWDOWN_USD=25

# ── Execution policy (defaults shown)
# auto: switch to live by the rules below; shadow: never send
# CHRONOS_MODE=auto
# share of the surplus above your floor bid as priority fee (Arbitrum orders each 125 ms round by priority fee)
# EXEC_TIP_SHARE_BPS=5000
# gas limit cap per transaction
# EXEC_MAX_GAS_UNITS=1500000
# gas you may lose to reverted transactions per UTC day; every send is sized so even a revert stays inside it, and reaching it switches back to shadow
# MAX_DAILY_GAS_USD=5
# reverted transactions in a row that switch back to shadow
# MAX_CONSECUTIVE_REVERTS=3
# executor ETH below this switches back to shadow (it cannot pay gas)
# EXEC_MIN_GAS_ETH=0.002
# wait before sending the same route again
# EXEC_ROUTE_COOLDOWN_SEC=30
# shadow wins in the last 24 h needed before live
# PROMOTE_MIN_WINS=5
# share of shadow runs that must win before live
# PROMOTE_MIN_WIN_RATE_BPS=6000
# profit guard: after this many live sends in a UTC day, a realized net ≤ $0 switches back to shadow until the next day
# GUARD_MIN_SENDS=5
# best approved routes simulated each scan
# EXEC_SHADOW_TOPK=3

# ── Deploy policy (defaults shown)
# per-asset loan cap above your largest ladder size, so a price move does not block the largest trade
# MAX_LOAN_HEADROOM_PCT=20
# ETH the executor should hold for gas; only the shortfall is sent
# EXEC_GAS_TOPUP_ETH=0.005
